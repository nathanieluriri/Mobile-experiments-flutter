<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The notice that a document has arrived in a folder quire reads. On
         Android 13 and later the reader is asked for this, when the first
         folder is handed over and not before. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Keeps the look for new documents scheduled across a restart of the
         phone. Granted at install and never asked about. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <application
        android:label="Quire"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules">
        <!-- Nothing leaves the phone, the library included. Left on, backup
             copies every imported document to the owner's cloud account and
             on to their next phone. -->
        <!-- The reader is a sheet of paper held upright, so the screen stays
             upright. A page the file says is turned is turned by the reader
             when it draws it, and a thumb resting on the fore edge is not a
             request to lay the whole app out again sideways. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- A document opened from another app arrives on the incoming
                 channel, not as a route. Left on, Flutter takes the document's
                 content address and starts the app on it as a page name, and
                 every segment of it becomes a blank page the reader has to
                 press back through. -->
            <meta-data
              android:name="flutter_deeplinking_enabled"
              android:value="false" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- Opening a document from a file manager, a mail client or a browser
             download, and being sent one from another app's share sheet. One
             alias for each kind of file quire reads.

             They are aliases and not filters on the activity because an icon
             and a label hang off a component, and there is only one activity:
             with the filters up there, every chooser in the phone showed the
             bare logo and left the reader to remember what they had tapped.
             Each of these is the same activity wearing the mark of the file it
             is about to open. None of them is a way into the app on its own,
             and none carries a launcher category, so the home screen still has
             exactly the one icon it had before.

             The types are split so that no file can match two aliases, which
             would stand quire in the chooser twice. An intent names exactly one
             type, so the whole of the rule is this: a type string appears on
             one alias and on no other, and nothing here uses a wildcard. A
             text/* on the markdown alias would take in text/csv as well, and
             then a csv would match two of these at once. A csv offered as
             text/csv is the csv alias's; the same file offered as text/plain is
             the markdown alias's. Which of the two the phone says is the
             phone's business, and either way one alias answers.

             Every alias repeats the activity's two meta-data lines because the
             engine reads them off the component it was launched through, and an
             alias is not the activity it points at. Left off, a document opened
             through one of these would be read as a deep link again, a blank
             page for every segment of its address. -->
        <activity-alias
            android:name=".OpenPdf"
            android:targetActivity=".MainActivity"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_open_pdf"
            android:label="Quire · PDF">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <meta-data
              android:name="flutter_deeplinking_enabled"
              android:value="false" />
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="content"/>
                <data android:scheme="file"/>
                <data android:mimeType="application/pdf"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <action android:name="android.intent.action.SEND_MULTIPLE"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="application/pdf"/>
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".OpenDoc"
            android:targetActivity=".MainActivity"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_open_doc"
            android:label="Quire · DOC">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <meta-data
              android:name="flutter_deeplinking_enabled"
              android:value="false" />
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="content"/>
                <data android:scheme="file"/>
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <action android:name="android.intent.action.SEND_MULTIPLE"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document"/>
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".OpenXls"
            android:targetActivity=".MainActivity"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_open_xls"
            android:label="Quire · XLS">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <meta-data
              android:name="flutter_deeplinking_enabled"
              android:value="false" />
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="content"/>
                <data android:scheme="file"/>
                <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <action android:name="android.intent.action.SEND_MULTIPLE"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"/>
            </intent-filter>
        </activity-alias>

        <!-- Only the zipped Office formats are claimed. The older .doc, .xls
             and .ppt are compound files quire cannot read, and offering to
             open one only to call it damaged is a claim the app cannot keep. -->
        <activity-alias
            android:name=".OpenPpt"
            android:targetActivity=".MainActivity"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_open_ppt"
            android:label="Quire · PPT">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <meta-data
              android:name="flutter_deeplinking_enabled"
              android:value="false" />
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="content"/>
                <data android:scheme="file"/>
                <data android:mimeType="application/vnd.openxmlformats-officedocument.presentationml.presentation"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <action android:name="android.intent.action.SEND_MULTIPLE"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="application/vnd.openxmlformats-officedocument.presentationml.presentation"/>
            </intent-filter>
        </activity-alias>

        <!-- Tab separated files are read as csv, delimiter and all, so they
             belong to the csv mark rather than to a mark of their own. -->
        <activity-alias
            android:name=".OpenCsv"
            android:targetActivity=".MainActivity"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_open_csv"
            android:label="Quire · CSV">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <meta-data
              android:name="flutter_deeplinking_enabled"
              android:value="false" />
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="content"/>
                <data android:scheme="file"/>
                <data android:mimeType="text/csv"/>
                <data android:mimeType="text/tab-separated-values"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <action android:name="android.intent.action.SEND_MULTIPLE"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="text/csv"/>
                <data android:mimeType="text/tab-separated-values"/>
            </intent-filter>
        </activity-alias>

        <!-- Markdown, and plain text with it. quire reads a .txt as markdown,
             so the MD mark says what it would open one as. This is the one
             claim on the list that reaches past documents, because every note,
             log and config file on the phone is text/plain too: quire is
             offered for all of them and is the default for none, which is the
             price of being reachable from a text file at all. -->
        <activity-alias
            android:name=".OpenMd"
            android:targetActivity=".MainActivity"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_open_md"
            android:label="Quire · MD">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <meta-data
              android:name="flutter_deeplinking_enabled"
              android:value="false" />
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="content"/>
                <data android:scheme="file"/>
                <data android:mimeType="text/markdown"/>
                <data android:mimeType="text/plain"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <action android:name="android.intent.action.SEND_MULTIPLE"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="text/markdown"/>
                <data android:mimeType="text/plain"/>
            </intent-filter>
        </activity-alias>
        <!-- Looks in the folders quire was handed for new documents, on the
             phone's own schedule. -->
        <service
            android:name=".ArrivalJob"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="false" />
        <receiver
            android:name=".NoticeDismissed"
            android:exported="false" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
