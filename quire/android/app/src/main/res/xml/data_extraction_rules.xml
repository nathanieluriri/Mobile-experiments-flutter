<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing quire holds leaves the phone: not to the owner's cloud backup and
     not to a new phone in a transfer. From Android 12 allowBackup alone no
     longer covers the transfer, so both are excluded here. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
